NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/motoclube

FRONTEND_URL=http://localhost:5173

JWT_SECRET=troque-por-um-segredo-com-no-minimo-48-bytes
JWT_EXPIRES_IN=8h
COOKIE_NAME=mc_access
COOKIE_SAME_SITE=lax

QR_HMAC_SECRET=troque-por-outro-segredo-forte-e-diferente
QR_TTL_SECONDS=60

PAYMENT_WEBHOOK_SECRET=troque-por-um-segredo-de-webhook-forte

# Sessão do parceiro
PARTNER_JWT_EXPIRES_IN=10h

# Somente para seed local de demonstração
DEMO_ADMIN_PASSWORD=troque-esta-senha-local
DEMO_PARTNER_PASSWORD=troque-esta-senha-local
ALLOW_DEMO_SEED=false
